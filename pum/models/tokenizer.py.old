"""
tokenizer.py — Multi-scale residual FSQ tokenizer for 32^3 voxel grids.

Architecture (living.tex Section 3):
  Encoder:  Embedding → 3D conv stack → (B, C, 8, 8, 8)
  Bottleneck: 4-scale residual FSQ  → 585 tokens total (1+8+64+512)
              d=6, L=5 per token, RFSQ per-stage scaling
  Decoder:  3D conv stack → (B, V, 32, 32, 32) logits

Stage 1 uses a flat classifier over ~200 observed token IDs (not hierarchical).
"""

import torch
import torch.nn as nn
import torch.nn.functional as F


# ── Building blocks ──────────────────────────────────────────────────────────

class ResBlock3D(nn.Module):
    def __init__(self, channels: int):
        super().__init__()
        groups = min(8, channels)
        self.net = nn.Sequential(
            nn.Conv3d(channels, channels, 3, padding=1, bias=False),
            nn.GroupNorm(groups, channels),
            nn.ReLU(inplace=True),
            nn.Conv3d(channels, channels, 3, padding=1, bias=False),
            nn.GroupNorm(groups, channels),
        )

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        return F.relu(x + self.net(x), inplace=True)


# ── FSQ stage ────────────────────────────────────────────────────────────────

class FSQStage(nn.Module):
    """
    One stage of the multi-scale residual FSQ.

    Projects channels → d dims, applies RFSQ scaling + GroupNorm, rounds to
    {-half_L, ..., half_L} with straight-through estimator, projects back.
    """

    def __init__(self, channels: int, d: int = 6, L: int = 5):
        super().__init__()
        assert L % 2 == 1, "L must be odd so levels are symmetric around 0"
        self.d = d
        self.L = L
        self.half_L = L // 2

        self.proj_in = nn.Conv3d(channels, d, 1, bias=False)
        self.proj_out = nn.Conv3d(d, channels, 1, bias=False)
        self.gamma = nn.Parameter(torch.ones(1))  # RFSQ per-stage scale
        self.norm = nn.GroupNorm(1, d)             # normalise before rounding

    def forward(self, x: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
        """
        Args:
            x: (B, C, *spatial)
        Returns:
            x_out: (B, C, *spatial)  quantised and projected back
            token_ids: (B, *spatial)  packed integer token index
        """
        z = self.proj_in(x)            # (B, d, *spatial)
        z = z * self.gamma
        z = self.norm(z)

        # Bound to [-half_L, half_L] and round (straight-through)
        z_bound = self.half_L * torch.tanh(z)
        z_q = z_bound + (z_bound.round() - z_bound).detach()

        x_out = self.proj_out(z_q)     # (B, C, *spatial)

        # Pack d-dim vector to single token index for logging / cycle accuracy
        # Each dim in {0,...,L-1} after shift; packed as base-L integer
        with torch.no_grad():
            z_idx = (z_q.detach() + self.half_L).round().long().clamp(0, self.L - 1)
            # (B, d, *spatial) → (B, *spatial)
            powers = torch.tensor(
                [self.L ** i for i in range(self.d)],
                device=x.device, dtype=torch.long,
            )
            spatial_dims = len(z_idx.shape) - 2
            view_shape = (1, self.d) + (1,) * spatial_dims
            token_ids = (z_idx * powers.view(view_shape)).sum(dim=1)

        return x_out, token_ids


# ── Multi-scale residual FSQ bottleneck ──────────────────────────────────────

class MultiScaleResidualFSQ(nn.Module):
    """
    4-scale residual FSQ: 1^3, 2^3, 4^3, 8^3 → 585 tokens total.

    At each scale:
      1. Pool residual to target size
      2. FSQ-quantise
      3. Project back to C dims, upsample to 8^3, subtract from residual
    Decoder input = sum of all scale contributions ≈ original F.
    """

    SCALES = [1, 2, 4, 8]  # target spatial sizes, coarse → fine

    def __init__(self, channels: int = 256, d: int = 6, L: int = 5):
        super().__init__()
        self.stages = nn.ModuleList(
            [FSQStage(channels, d, L) for _ in self.SCALES]
        )

    def forward(self, feat: torch.Tensor) -> tuple[torch.Tensor, list[torch.Tensor]]:
        """
        Args:
            feat: (B, C, 8, 8, 8)
        Returns:
            z_sum: (B, C, 8, 8, 8)  sum of quantised scale contributions
            token_ids: list of (B, s, s, s) for s in [1,2,4,8]
        """
        residual = feat
        z_sum = torch.zeros_like(feat)
        all_token_ids = []

        for stage, s in zip(self.stages, self.SCALES):
            # Pool residual to s^3
            pooled = torch.nn.functional.adaptive_avg_pool3d(residual, (s, s, s))

            # Quantise
            z_q, token_ids = stage(pooled)   # (B, C, s, s, s)
            all_token_ids.append(token_ids)

            # Upsample back to 8^3 and accumulate
            z_up = F.interpolate(z_q, size=(8, 8, 8), mode="nearest")
            z_sum = z_sum + z_up

            # Subtract from residual (coarse → fine residual quantisation)
            residual = residual - z_up

        return z_sum, all_token_ids


# ── Encoder ──────────────────────────────────────────────────────────────────

class Encoder3D(nn.Module):
    """Embed token IDs → 3D conv stack → (B, C, 8, 8, 8)."""

    def __init__(self, vocab_size: int, d_embed: int = 32, channels: int = 256):
        super().__init__()
        self.embed = nn.Embedding(vocab_size, d_embed, padding_idx=0)
        g64 = min(8, 64)
        g128 = min(8, 128)
        gC = min(8, channels)
        self.net = nn.Sequential(
            nn.Conv3d(d_embed, 64, 3, padding=1, bias=False),
            nn.GroupNorm(g64, 64),
            nn.ReLU(inplace=True),
            ResBlock3D(64),
            nn.Conv3d(64, 128, 3, stride=2, padding=1, bias=False),   # 32 → 16
            nn.GroupNorm(g128, 128),
            nn.ReLU(inplace=True),
            ResBlock3D(128),
            nn.Conv3d(128, channels, 3, stride=2, padding=1, bias=False),  # 16 → 8
            nn.GroupNorm(gC, channels),
            nn.ReLU(inplace=True),
            ResBlock3D(channels),
        )

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        # x: (B, 32, 32, 32) long
        e = self.embed(x)                    # (B, 32, 32, 32, d_embed)
        e = e.permute(0, 4, 1, 2, 3)        # (B, d_embed, 32, 32, 32)
        return self.net(e)                   # (B, channels, 8, 8, 8)


# ── Decoder ──────────────────────────────────────────────────────────────────

class Decoder3D(nn.Module):
    """(B, C, 8, 8, 8) → (B, V, 32, 32, 32) logits via upsample + conv."""

    def __init__(self, channels: int = 256, vocab_size: int = 512):
        super().__init__()
        g128 = min(8, 128)
        g64 = min(8, 64)
        gC = min(8, channels)
        self.net = nn.Sequential(
            ResBlock3D(channels),
            nn.Upsample(scale_factor=2, mode="trilinear", align_corners=False),  # 8→16
            nn.Conv3d(channels, 128, 3, padding=1, bias=False),
            nn.GroupNorm(g128, 128),
            nn.ReLU(inplace=True),
            ResBlock3D(128),
            nn.Upsample(scale_factor=2, mode="trilinear", align_corners=False),  # 16→32
            nn.Conv3d(128, 64, 3, padding=1, bias=False),
            nn.GroupNorm(g64, 64),
            nn.ReLU(inplace=True),
            nn.Conv3d(64, vocab_size, 1),
        )

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        return self.net(x)  # (B, V, 32, 32, 32)


# ── Full tokenizer ────────────────────────────────────────────────────────────

class VoxelTokenizer(nn.Module):
    """
    Full multi-scale residual FSQ voxel tokenizer.

    forward() returns logits for training. Use encode() / decode() at inference.
    """

    def __init__(
        self,
        vocab_size: int,
        d_embed: int = 32,
        channels: int = 256,
        fsq_d: int = 6,
        fsq_L: int = 5,
    ):
        super().__init__()
        self.vocab_size = vocab_size
        self.encoder = Encoder3D(vocab_size, d_embed, channels)
        self.bottleneck = MultiScaleResidualFSQ(channels, fsq_d, fsq_L)
        self.decoder = Decoder3D(channels, vocab_size)

        # Token counts per scale for reporting
        self.scale_token_counts = [s ** 3 for s in MultiScaleResidualFSQ.SCALES]
        self.total_tokens = sum(self.scale_token_counts)  # 585

    def forward(
        self, x: torch.Tensor
    ) -> tuple[torch.Tensor, list[torch.Tensor]]:
        """
        Args:
            x: (B, 32, 32, 32) long  — token IDs
        Returns:
            logits:    (B, V, 32, 32, 32)
            token_ids: list of (B, s, s, s) for s in [1,2,4,8]
        """
        F = self.encoder(x)
        z_sum, token_ids = self.bottleneck(F)
        logits = self.decoder(z_sum)
        return logits, token_ids

    @torch.no_grad()
    def encode(self, x: torch.Tensor) -> list[torch.Tensor]:
        """Return multi-scale token IDs (no gradients)."""
        F = self.encoder(x)
        _, token_ids = self.bottleneck(F)
        return token_ids

    @torch.no_grad()
    def decode(self, x: torch.Tensor) -> torch.Tensor:
        """Full forward, return argmax predictions (B, 32, 32, 32)."""
        logits, _ = self.forward(x)
        return logits.argmax(dim=1)

    @torch.no_grad()
    def cycle_accuracy(self, x: torch.Tensor) -> float:
        """
        Encode x → tokens, decode → x_hat (argmax), re-encode → tokens2.
        Return fraction of tokens that match (token-level cycle accuracy).
        """
        tokens1_list = self.encode(x)
        x_hat = self.decode(x)
        tokens2_list = self.encode(x_hat)

        total = matched = 0
        for t1, t2 in zip(tokens1_list, tokens2_list):
            total += t1.numel()
            matched += (t1 == t2).sum().item()
        return matched / total if total > 0 else 0.0
