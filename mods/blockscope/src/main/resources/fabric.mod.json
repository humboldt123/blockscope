      "com.blockscope.BlockscopeClient"
    ]
  },
  "mixins": [
    "blockscope.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.0",
    "fabric": "*",
    "minecraft": "1.19.4"
  }
