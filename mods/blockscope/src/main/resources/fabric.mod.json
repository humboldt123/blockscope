  "authors": [
    "humboldt123"
  ],
  "contact": {
    "homepage": "https://github.com/humboldt123/blockscope",
    "sources": "https://github.com/humboldt123/blockscope"
  },
  "license": "MIT",
  "icon": "assets/blockscope/icon.png",
  "environment": "client",
  "entrypoints": {
